[
  {
    "start": 5.5,
    "end": 8.0,
    "line": "君が触れた たったった"
  },
  {
    "start": 8.0,
    "end": 12.0,
    "line": "ただの花さえ笑って 宙に叫え"
  },
  {
    "start": 12.0,
    "end": 16.0,
    "line": "君にだって 照れるまま座って"
  },
  {
    "start": 16.12,
    "end": 19.0,
    "line": "バスの最終時刻をパー"
  },
  {
    "start": 30.02,
    "end": 41.5,
    "line": "水紋の通りバス停で君はさ、板を持っていた それだって様になってるな"
  },
  {
    "start": 42.0,
    "end": 53.5,
    "line": "知らないものだけ出会った僕はその風景を描いていた 隣に座る間もなく消えたパスが走ってく"
  },
  {
    "start": 53.64,
    "end": 57.9,
    "line": "書いて 書いて ようやく"
  },
  {
    "start": 58.16,
    "end": 62.7,
    "line": "得たものが 痛みとか 下げすみとか"
  },
  {
    "start": 62.7,
    "end": 65.3,
    "line": "なんかも 忘れたい"
  },
  {
    "start": 65.5,
    "end": 68.0,
    "line": "君が触れたら たったったった"
  },
  {
    "start": 68.0,
    "end": 71.7,
    "line": "あの花さえ笑って 宙に叫びへ"
  },
  {
    "start": 71.86,
    "end": 77.3,
    "line": "君が登って 照れる雲を 上がらんで飛んでいく"
  },
  {
    "start": 77.48,
    "end": 79.9,
    "line": "君がいるなら たったったった"
  },
  {
    "start": 79.9,
    "end": 83.6,
    "line": "いくつな日々もなんてことはないけど"
  },
  {
    "start": 83.6,
    "end": 87.9,
    "line": "君がいた想像しなつもさよなら"
  },
  {
    "start": 88.12,
    "end": 90.9,
    "line": "誰かをどう願おうか"
  },
  {
    "start": 104.08,
    "end": 109.4,
    "line": "雨の街路あき 君は立っていた"
  },
  {
    "start": 110.1,
    "end": 113.4,
    "line": "片手には赤いカトリア"
  },
  {
    "start": 113.4,
    "end": 119.4,
    "line": "君の名が下すいてきた 夕立ちにいた靴立っていた"
  },
  {
    "start": 119.4,
    "end": 125.4,
    "line": "君が泣いてるの見ては動いた 声もかけないで"
  },
  {
    "start": 126.06,
    "end": 128.4,
    "line": "その顔を書いていた"
  },
  {
    "start": 128.64,
    "end": 132.9,
    "line": "吐いて吐いてようやく"
  },
  {
    "start": 133.12,
    "end": 136.14,
    "line": "わかるのが痛みです"
  },
  {
    "start": 136.14,
    "end": 138.92,
    "line": "無償しさです なんかもう"
  },
  {
    "start": 138.92,
    "end": 141.76,
    "line": "馬鹿みたい満たされるから"
  },
  {
    "start": 141.76,
    "end": 143.96,
    "line": "たったりってたぶん"
  },
  {
    "start": 143.96,
    "end": 146.6,
    "line": "どうして嫌になるんだよ"
  },
  {
    "start": 146.6,
    "end": 149.96,
    "line": "それでよかったって笑えるほど"
  },
  {
    "start": 149.96,
    "end": 152.2,
    "line": "大人じゃないのにさ"
  },
  {
    "start": 152.2,
    "end": 153.72,
    "line": "君が乗り込む"
  },
  {
    "start": 153.72,
    "end": 156.0,
    "line": "パッパッパスの隙間に"
  },
  {
    "start": 156.0,
    "end": 158.7,
    "line": "何僕の場所はないから"
  },
  {
    "start": 158.84,
    "end": 163.0,
    "line": "君がいた想像だけが重ねゆく"
  },
  {
    "start": 163.16,
    "end": 166.0,
    "line": "常人生不観法化"
  },
  {
    "start": 173.82,
    "end": 175.5,
    "line": "ご視聴ありがとうございました"
  },
  {
    "start": 188.84,
    "end": 195.3,
    "line": "ああ 君が歩けば花が咲く 君が歩けば空が泣く"
  },
  {
    "start": 195.4,
    "end": 201.3,
    "line": "君が笑えば遠い夏 笑う顔が描いてみたい"
  },
  {
    "start": 201.4,
    "end": 212.3,
    "line": "夕立の中泣く君に 僕が言えるのなら もう一回 あの夏に戻って"
  },
  {
    "start": 212.46,
    "end": 218.2,
    "line": "君が泣いてると止まらない理由を僕は知っていたい"
  },
  {
    "start": 218.2,
    "end": 224.2,
    "line": "君に触れたら適当なことでも喋ってみよう"
  },
  {
    "start": 224.2,
    "end": 230.6,
    "line": "君がいたから退屈な日々もなんてことはないのさ"
  },
  {
    "start": 230.6,
    "end": 234.9,
    "line": "君に笑って照れるまま座って"
  },
  {
    "start": 234.9,
    "end": 237.9,
    "line": "バスの最終時刻オーバー"
  },
  {
    "start": 246.06,
    "end": 247.0,
    "line": "ご視聴ありがとうございました"
  }
]