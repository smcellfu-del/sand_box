[
  {
    "start": 1.56,
    "end": 6.7,
    "line": "雨の匂いに懐かしくなるのはなんでなんでしょうか"
  },
  {
    "start": 7.08,
    "end": 11.7,
    "line": "夏が近づくと胸がざわめくのはなんでなんでしょうか"
  },
  {
    "start": 11.7,
    "end": 17.7,
    "line": "人に笑われたら涙が出るのはなんでなんでしょうか"
  },
  {
    "start": 18.5,
    "end": 22.7,
    "line": "それでもいつか報われるからと思えばいいんでしょうか"
  },
  {
    "start": 22.74,
    "end": 28.7,
    "line": "さよならって言葉で こんなに胸を裂いて"
  },
  {
    "start": 28.7,
    "end": 33.7,
    "line": "今もたった数瞬の夕焼けに"
  },
  {
    "start": 35.28,
    "end": 36.7,
    "line": "足が止まっていた"
  },
  {
    "start": 36.7,
    "end": 39.7,
    "line": "先生 人生相談です"
  },
  {
    "start": 39.7,
    "end": 42.7,
    "line": "この先どうなら楽ですか"
  },
  {
    "start": 42.7,
    "end": 46.7,
    "line": "そんなの誰も分かりはしないよなんて言われますか"
  },
  {
    "start": 46.7,
    "end": 50.7,
    "line": "ほら 苦しさなんて欲しいわけない"
  },
  {
    "start": 50.7,
    "end": 53.7,
    "line": "何もしないで生きていたい"
  },
  {
    "start": 53.7,
    "end": 57.7,
    "line": "青空だけが見たいのは若ままですか"
  },
  {
    "start": 72.12,
    "end": 77.04,
    "line": "胸が痛んでも嘘がつけるのはなんでなんでしょうか"
  },
  {
    "start": 77.64,
    "end": 82.6,
    "line": "悪い人ばかりが得をしてるのはなんでなんでしょうか"
  },
  {
    "start": 83.32,
    "end": 88.2,
    "line": "幸せの持ちがお金を含むのはなんでなんでしょうか"
  },
  {
    "start": 88.96,
    "end": 93.6,
    "line": "一つ線を抜けば辛さになるのはわざとなんでしょうか"
  },
  {
    "start": 93.6,
    "end": 99.4,
    "line": "青春ってネクタが背中に張られていて"
  },
  {
    "start": 99.4,
    "end": 104.4,
    "line": "一時刻みたいなサスペンスを"
  },
  {
    "start": 106.02,
    "end": 107.4,
    "line": "どこかで大していた"
  },
  {
    "start": 107.4,
    "end": 110.4,
    "line": "センフレードでもいいんですよ"
  },
  {
    "start": 110.4,
    "end": 113.4,
    "line": "生きてるだけで痛いんですよ"
  },
  {
    "start": 113.4,
    "end": 117.4,
    "line": "ユージもフロイトもこの穴の埋め方は書かないんだ"
  },
  {
    "start": 117.4,
    "end": 121.4,
    "line": "ただ夏の匂いに目を瞑って"
  },
  {
    "start": 121.4,
    "end": 124.4,
    "line": "雲の高さを指で書こう"
  },
  {
    "start": 124.4,
    "end": 128.4,
    "line": "思い出だけが見たいのはワガママですか"
  },
  {
    "start": 128.4,
    "end": 130.4,
    "line": "Gone Gone Gone"
  },
  {
    "start": 139.32,
    "end": 144.5,
    "line": "ブラマチックに人が死ぬストーリーって 売れるじゃないですか"
  },
  {
    "start": 144.5,
    "end": 150.5,
    "line": "花の散り際に砂目がつくのも嫌になりました"
  },
  {
    "start": 150.86,
    "end": 155.5,
    "line": "先生の夢は何だったんですか"
  },
  {
    "start": 156.14,
    "end": 161.5,
    "line": "大人になると忘れちゃうもんなんですか"
  },
  {
    "start": 161.82,
    "end": 167.5,
    "line": "先生人生相談です この先どうなら楽ですか"
  },
  {
    "start": 167.5,
    "end": 172.0,
    "line": "涙が一つよくするなんて全部機便でした"
  },
  {
    "start": 172.0,
    "end": 176.0,
    "line": "ああ この先どうでも言い訳なくて"
  },
  {
    "start": 176.0,
    "end": 180.5,
    "line": "現実だけが散らずいて夏が遠くて"
  },
  {
    "start": 181.54,
    "end": 184.5,
    "line": "これでも本当にいいんですか?"
  },
  {
    "start": 184.5,
    "end": 187.0,
    "line": "このまま生きてもいいんですか?"
  },
  {
    "start": 187.2,
    "end": 191.5,
    "line": "そんなの君にしかわからないよなんて言われますか?"
  },
  {
    "start": 191.5,
    "end": 195.5,
    "line": "ただ夏の匂いに目を瞑りたい"
  },
  {
    "start": 195.66,
    "end": 198.3,
    "line": "いつまでも風に打たれたい"
  },
  {
    "start": 198.48,
    "end": 202.2,
    "line": "青空だけが見たいのは我儘ですか"
  },
  {
    "start": 204.14,
    "end": 207.7,
    "line": "あなただけを知りたいのは我儘ですか"
  }
]