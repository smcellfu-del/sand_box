    "line": "ただ気に食わないものばかりが増えた"
  },
  {
    "start": 42.0,
    "end": 50.0,
    "line": "8月号月明かり自転車で飛んで 東不思議の高架橋 古代ラフじみ通り途上展開"
  },
  {
    "start": 50.0,
    "end": 54.4,
    "line": "夜風が花を潰すぐった この胸の痛みは気のせいだ"
  },
  {
    "start": 54.4,
    "end": 57.3,
    "line": "分かっただ わかった 振り下"
  },
  {
    "start": 61.08,
    "end": 69.2,
    "line": "最低だ 最低だ 僕の全部最低だ 君を形し残したかった 想い出になんてしてやるもんか"
  },
  {
    "start": 69.2,
    "end": 78.2,
    "line": "最低だ 最低だ 気持ちよくて仕方がないわ 最低 だってこの歌詞自体が"
  },
  {
    "start": 78.8,
    "end": 83.2,
    "line": "人生27で死ねるならロックンロールは僕を救った"
  },
  {
    "start": 83.2,
    "end": 87.2,
    "line": "考えるのもやめだ 同性死ぬんだから"
  },
  {
    "start": 87.54,
    "end": 90.2,
    "line": "君も何もいらない"
  },
  {
    "start": 111.76,
    "end": 116.2,
    "line": "心臓がうるさかった 笑うほど喉が渇いた"
  },
  {
    "start": 117.02,
    "end": 119.2,
    "line": "初めて心を売り出した"
  },
  {
    "start": 120.02,
    "end": 124.2,
    "line": "強心もプライドも もうどうでもよかった"
  },
  {
    "start": 124.64,
    "end": 128.2,
    "line": "気に食わない奴にも頭を下げた"
  },
  {
    "start": 129.28,
    "end": 133.2,
    "line": "8月号あの頃の景色をまたいだ"
  },
  {
    "start": 133.66,
    "end": 137.2,
    "line": "ストックホルムのロテンション キレナがムラスタンは石畳"
  },
  {
    "start": 137.2,
    "end": 142.2,
    "line": "君だけを胸にしまった この空の青さも気のせいだ"
  },
  {
    "start": 142.22,
    "end": 145.2,
    "line": "笑ったか 笑った顔のまま"
  },
  {
    "start": 148.04,
    "end": 152.5,
    "line": "最低だ 傲慢だ 君もみんなどんよくた"
  },
  {
    "start": 152.5,
    "end": 156.5,
    "line": "ドラマチックな歌も愛もさ バカらしくて仕方がないわ"
  },
  {
    "start": 156.5,
    "end": 161.5,
    "line": "知っていた 知っていた 君の人生 君のものだ"
  },
  {
    "start": 161.72,
    "end": 165.5,
    "line": "最低だって いくら叫ぼうが"
  },
  {
    "start": 166.02,
    "end": 170.5,
    "line": "そうだ きっとそうだ あの世ではロックンロールが流れてるんだ"
  },
  {
    "start": 170.5,
    "end": 174.5,
    "line": "三微化とか流行らない 神様がいないんだから"
  },
  {
    "start": 174.84,
    "end": 180.4,
    "line": "罪も 誤ちも 犯罪も 自殺も 戦争も マイナリティも"
  },
  {
    "start": 180.7,
    "end": 182.4,
    "line": "全部知らない"
  },
  {
    "start": 202.92,
    "end": 211.2,
    "line": "最低だ 最低だ 別れなんてごまんだ 君の全てにうなずけたいんだ そんなの欺瞞となし絶えれば"
  },
  {
    "start": 211.2,
    "end": 219.2,
    "line": "最低だ 最低だ 愛おしくて仕方がないわ ドラマジックな夜で僕を痛みたい"
  },
  {
    "start": 220.36,
    "end": 228.2,
    "line": "最低だ 最低だ 言葉なんて情緒だ 君の人生は月明かりだ ありがちだなんて言わせるもんか"
  },
  {
    "start": 228.2,
    "end": 233.2,
    "line": "最低だ 最低だ 笑われたって仕方がないわ"
  },
  {
    "start": 233.2,
    "end": 237.2,
    "line": "最低 なんて このだけの歌詞だ"
  },
  {
    "start": 238.06,
    "end": 242.2,
    "line": "人生27で死ねるなら ロックンロールは僕を救った"
  },
  {
    "start": 242.2,
