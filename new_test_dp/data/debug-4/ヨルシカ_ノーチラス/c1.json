[
  {
    "start": 5.82,
    "end": 11.0,
    "line": "時計が鳴ったから やっと目を覚ました"
  },
  {
    "start": 11.0,
    "end": 16.0,
    "line": "昨日の風がちょっと嘘みたいだ"
  },
  {
    "start": 18.04,
    "end": 23.0,
    "line": "出かけようにも ああ 予報がメモ用だ"
  },
  {
    "start": 23.0,
