[
  {
    "start": 29.6,
    "end": 33.7,
    "line": "人に優しいあんたに この心がわかるものか"
  },
  {
    "start": 33.96,
    "end": 38.7,
    "line": "人を呪うのが心地いい だから歌を書いていた"
  },
  {
    "start": 39.22,
    "end": 43.7,
    "line": "そのほどニュースに いつか乗ることが夢だった"
  },
  {
    "start": 43.82,
    "end": 47.7,
    "line": "そのために包丁を研いでる"
  },
  {
    "start": 48.52,
    "end": 52.7,
    "line": "ガラスをたったきつける音 何かの紙を破ること"
  },
  {
    "start": 52.76,
    "end": 57.7,
    "line": "さよならの後の夕日が美しいね"
  },
  {
    "start": 58.08,
    "end": 64.46,
    "line": "君だってわかるだろ ガラスの歌にあかんね"
  },
  {
    "start": 64.46,
    "end": 73.5,
    "line": "この孤独を今 音に変わる面影に刺したギグル"
  },
  {
    "start": 73.5,
    "end": 78.22,
    "line": "つま先がつくもがやける"
  },
  {
    "start": 78.54,
    "end": 82.62,
    "line": "さよならが口をすべる"
  },
  {
    "start": 101.64,
    "end": 105.5,
    "line": "認められたい 愛したい これが夢っていつか"
  },
  {
    "start": 105.5,
    "end": 110.5,
    "line": "何もしなくても叶えよう 早く僕を満たしてくれ"
  },
  {
    "start": 111.08,
    "end": 115.0,
    "line": "人に優しい世間に この女神がわかるものが"
  },
  {
    "start": 115.0,
    "end": 119.0,
    "line": "いつも誰かを殴れる機会を探してる"
  },
  {
    "start": 120.48,
    "end": 125.0,
    "line": "ビール瓶で殴る街路と 投げるギターの折れる音"
  },
  {
    "start": 125.0,
    "end": 130.0,
    "line": "戻らない後悔の全部が美しいって そういうのさ"
  },
  {
    "start": 130.14,
    "end": 136.56,
    "line": "僕だってわかるのに言葉の雨に打たれ"
  },
  {
    "start": 136.56,
    "end": 141.36,
    "line": "秋をしむ雨 冬に落ちる"
  },
  {
    "start": 141.36,
    "end": 150.32,
    "line": "春の山のお城から また一つ煙が立つ"
  },
  {
    "start": 150.44,
    "end": 154.64,
    "line": "夏風が頬をすべる"
  },
  {
    "start": 164.04,
    "end": 167.9,
    "line": "人に優しいあんたに この孤独がわかるものが"
  },
  {
    "start": 167.9,
    "end": 173.1,
    "line": "死にたくないが生きられない だから歌を書いている"
  },
  {
    "start": 173.5,
    "end": 178.1,
    "line": "罵倒も失望も嫌悪も 僕への興味だと思うから"
  },
  {
    "start": 178.1,
    "end": 182.9,
    "line": "人を傷つける歌を書いてる"
  },
  {
    "start": 183.28,
    "end": 185.9,
    "line": "こんな中身のない歌を書いてる"
  },
  {
    "start": 189.5,
    "end": 193.9,
    "line": "君の言葉が飲みたい"
  },
  {
    "start": 193.9,
    "end": 198.9,
    "line": "入れ物もない両手で受けて"
  },
  {
    "start": 198.9,
    "end": 202.9,
    "line": "いつしか喉がうるおう"
  },
  {
    "start": 202.9,
    "end": 207.9,
    "line": "その時を待ちながら"
  },
  {
    "start": 208.72,
    "end": 212.9,
    "line": "ガラスの歌にあかね"
  },
  {
    "start": 212.9,
    "end": 215.9,
    "line": "この孤独よ"
  },
  {
    "start": 215.9,
    "end": 219.64,
    "line": "今歌に変われさよなら"
  },
  {
    "start": 219.64,
    "end": 222.36,
    "line": "君にあかね"
  },
  {
    "start": 222.36,
    "end": 227.06,
    "line": "僕は今 夜を待つ"
  },
  {
    "start": 227.06,
    "end": 231.9,
    "line": "また明日 口が滑る"
  },
  {
    "start": 248.36,
    "end": 248.9,
    "line": "ポンッ"
  }
]